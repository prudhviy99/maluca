# Copy this to .env and adjust as needed.
# .env is gitignored — never commit actual values.

# Port the Maluca proxy listens on
PORT=8080

# Upstream backend base URL
UPSTREAM_URL=http://localhost:8081

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Set to "true" only when Maluca sits behind a trusted load-balancer
# that correctly populates X-Forwarded-For. Spoofable otherwise.
TRUST_XFF=false
# Comma-separated exact load-balancer peer IPs; only used when TRUST_XFF=true.
TRUSTED_PROXIES=

# Client identity keying: NETWORK | COMPOSITE | FINGERPRINT
IDENTITY_STRATEGY=NETWORK

# Secret that signs challenge tokens and pass cookies (HMAC).
# MUST be set to a strong random value in any real deployment.
MALUCA_CHALLENGE_SECRET=change-me-to-a-long-random-string

# Token guarding /_maluca/admin/*. Blank disables the admin API.
MALUCA_ADMIN_TOKEN=change-me-admin-token

# Path to a hot-reloadable policy file. Blank = classpath default (no reload).
POLICY_FILE=

# OpenTelemetry trace export (Jaeger OTLP) + sampling probability.
OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACE_SAMPLING=0.1

# ── Optional AI incident-triage stack ────────────────────────────────────────
# Replace every token/key before exposing these services outside localhost.
TRIAGE_DATABASE_PASSWORD=change-me-database-password
TRIAGE_API_TOKEN=change-me-triage-operator-token
TRIAGE_CLIENT_HMAC_KEY=change-me-long-random-hmac-key
MALUCA_INTERNAL_TOKEN=change-me-proxy-to-triage-token
MCP_API_TOKEN=change-me-agent-read-propose-token
MCP_APPLY_TOKEN=change-me-separate-human-apply-token
MCP_APPLY_PRINCIPAL=on-call-operator

# Local Ollama models. nomic-embed-text must stay aligned with the configured
# 768-dimensional pgvector column unless a new migration changes both.
OLLAMA_CHAT_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONTEXT_SIZE=8192
OLLAMA_SEED=42
OLLAMA_INFERENCE_TIMEOUT=90s

# Agent claims are leased and failed incidents back off before retrying. After
# the bounded attempt count, TRIAGE_FAILED requires an explicit operator retry.
TRIAGE_AGENT_LEASE_TIMEOUT=15m
TRIAGE_AGENT_ORCHESTRATION_TIMEOUT=4m
TRIAGE_AGENT_MAX_TOOL_CALLS=8
TRIAGE_AGENT_MAX_ATTEMPTS=3
TRIAGE_AGENT_RETRY_BASE_DELAY=30s
TRIAGE_AGENT_RETRY_MAX_DELAY=5m
TRIAGE_AGENT_MAX_BRIEF_CHARACTERS=16000
TRIAGE_AGENT_MAX_SAMPLE_CHARACTERS=1200
TRIAGE_AGENT_MAX_SAMPLE_CONTRIBUTIONS=8

# Bound each triage-to-proxy admin connection and response. Valid ranges are
# 100ms..30s for connect and 100ms..60s for read.
TRIAGE_PROXY_CONNECT_TIMEOUT=2s
TRIAGE_PROXY_READ_TIMEOUT=5s

# Policy application has two independent fail-closed switches. Keep both false
# until the operator has reviewed a proposal and configured distinct tokens.
TRIAGE_POLICY_APPLY_ENABLED=false
MALUCA_MCP_APPLY_ENABLED=false
