# Copy this to .env and adjust as needed.
# .env is gitignored — never commit actual values.

# Port the Maluca proxy listens on
PORT=8080

# Upstream backend base URL
UPSTREAM_URL=http://localhost:8081

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Set to "true" only when Maluca sits behind a trusted load-balancer
# that correctly populates X-Forwarded-For. Spoofable otherwise.
TRUST_XFF=false

# Client identity keying: NETWORK | COMPOSITE | FINGERPRINT
IDENTITY_STRATEGY=NETWORK

# Secret that signs challenge tokens and pass cookies (HMAC).
# MUST be set to a strong random value in any real deployment.
MALUCA_CHALLENGE_SECRET=change-me-to-a-long-random-string

# Token guarding /_maluca/admin/*. Blank disables the admin API.
MALUCA_ADMIN_TOKEN=change-me-admin-token

# Path to a hot-reloadable policy file. Blank = classpath default (no reload).
POLICY_FILE=

# OpenTelemetry trace export (Jaeger OTLP) + sampling probability.
OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACE_SAMPLING=0.1
